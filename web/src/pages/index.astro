---
import '../styles/global.css';

const repo = 'https://github.com/Baizhi-Angelica/panasonic-hsp-to-heic';
const exe = `${repo}/releases/latest/download/HSP2HEIC.exe`;
const portable = `${repo}/releases/latest/download/HSP2HEIC-portable-win64.zip`;
const title = 'HSP → HEIC｜松下 HLG Photo 无损转 HEIC（浏览器本地完成）';
const description =
  '把松下 LUMIX 的 HLG Photo（.HSP）无损转成 HEIC。不解码、不压缩，像素逐字节一致；全程在浏览器本地完成，照片不上传。支持批量转换与 ZIP 下载。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f3ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://hlgconv.biotech-prank-0u.workers.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="HSP → HEIC · 无损，在浏览器里完成" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://hlgconv.biotech-prank-0u.workers.dev/" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('hsp-theme');
          const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = saved || (dark ? 'dark' : 'light');
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'HSP → HEIC',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Any (browser)',
      description,
      url: 'https://hlgconv.biotech-prank-0u.workers.dev/',
      license: 'https://opensource.org/licenses/MIT',
      author: { '@type': 'Person', name: 'Baizhi-Angelica', url: repo },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
    })} />
  </head>

  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="#top">
          <span class="mark" aria-hidden="true"></span>
          <span>HSP<span aria-hidden="true"> </span>→<span aria-hidden="true"> </span>HEIC</span>
        </a>
        <nav class="nav" aria-label="页面导航">
          <a href="#convert">转换</a>
          <a href="#method">原理</a>
          <a href="#privacy">数据安全</a>
          <a href="#about">关于</a>
          <a class="nav-github" href={repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false">
            <span class="dot" aria-hidden="true"></span>
            <span id="theme-label">夜间</span>
          </button>
        </nav>
      </div>
    </header>

    <main id="top">
      <!-- ---------------------------------------------------------- hero -->
      <section class="wrap hero">
        <div class="kicker mono">
          <span class="tag">Panasonic HLG Photo</span>
          <span>Lossless rewrap · no upload</span>
        </div>

        <h1>
          HSP <span class="arrow">→</span> HEIC
          <span class="sub">把 10-bit HLG HDR 从电脑里放出来。</span>
        </h1>

        <p class="lede">
          松下 LUMIX 的 <strong>.HSP</strong> 里本来就是一段 10-bit HLG 的 HEVC 码流，而 HEIC 就是 HEVC
          的 HEIF 容器。所以这里不解码、不重新压缩，只把码流原样搬进新容器并写对色彩标签——
          <em>像素与原文件逐字节一致</em>。整个转换在你的浏览器里完成，照片不会上传。
        </p>

        <dl class="meta-strip">
          <div>
            <dt>处理位置</dt>
            <dd>你的浏览器</dd>
          </div>
          <div>
            <dt>上传数据</dt>
            <dd>0 B</dd>
          </div>
          <div>
            <dt>图像</dt>
            <dd>10-bit · BT.2020 · HLG</dd>
          </div>
          <div>
            <dt>速度</dt>
            <dd>≈ 10 ms / 张</dd>
          </div>
        </dl>
      </section>

      <!-- ------------------------------------------------------ converter -->
      <section class="wrap section" id="convert">
        <div class="section-head">
          <span class="idx">01</span>
          <h2>转换</h2>
          <span class="en">Convert</span>
        </div>

        <div class="section-grid">
          <p class="lede mono" style="line-height:1.8;letter-spacing:.02em;text-transform:none">
            拖入或选择 .HSP，支持一次多张。单张直接下载 HEIC，多张打包成一个 ZIP。
          </p>

          <div class="converter">
            <div class="converter-top">
              <span class="label mono">输入 / INPUT</span>
              <span class="hint mono">仅 .HSP · 单张或批量</span>
            </div>

            <label class="dropzone" id="dropzone" for="file-input">
              <span class="dz-icon" aria-hidden="true"></span>
              <span class="dz-title">把 .HSP 拖到这里</span>
              <span class="dz-sub">或者点击选择文件 · 其他格式会被忽略</span>
              <span class="dz-cta" aria-hidden="true">选择文件</span>
              <input
                class="sr-only"
                id="file-input"
                type="file"
                accept=".hsp,.HSP,application/octet-stream"
                multiple
                aria-label="选择 .HSP 文件，可多选"
              />
            </label>

            <p class="banner" id="banner" hidden></p>

            <div class="actions">
              <button class="btn btn--accent" id="btn-download" type="button" disabled>
                下载
              </button>
              <button class="btn btn--ghost" id="btn-clear" type="button" disabled>清空</button>
              <span class="mono" style="color:var(--muted)">文件不会离开这台设备</span>
            </div>

            <div class="progress">
              <div class="progress-head">
                <span id="progress-label">等待文件</span>
                <span class="pct" id="progress-pct">0%</span>
              </div>
              <div
                class="progress-track"
                id="progress-track"
                role="progressbar"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
                aria-label="转换进度"
              >
                <div class="progress-fill" id="progress-fill"></div>
              </div>
            </div>

            <ol class="files" id="files" aria-live="polite"></ol>
            <p class="empty" id="empty">
              还没有文件。转换在本页完成，刷新即全部清空。
            </p>
          </div>
        </div>
      </section>

      <!-- --------------------------------------------------------- method -->
      <section class="wrap section" id="method">
        <div class="section-head">
          <span class="idx">02</span>
          <h2>原理</h2>
          <span class="en">Method</span>
        </div>

        <div class="section-grid">
          <p class="lede mono" style="line-height:1.8;letter-spacing:.02em;text-transform:none">
            只换容器，不动像素。搬运的是相机写出的那一条码流。
          </p>

          <div>
            <div class="method">
              <div class="blueprint">
                <h3>.HSP</h3>
                <p class="cap">TIFF wrapper</p>
                <ol>
                  <li><span>TIFF</span><span>IFD0 + ExifIFD 元数据</span></li>
                  <li><span>私有</span><span>松下 64 KB 块（不使用）</span></li>
                  <li class="is-kept"><span>HEVC</span><span>Main10 Annex-B 码流 · 原样保留</span></li>
                  <li><span>JPEG</span><span>内嵌预览图（丢弃）</span></li>
                </ol>
              </div>

              <div class="turn" aria-hidden="true">→</div>

              <div class="blueprint">
                <h3>.HEIC</h3>
                <p class="cap">ISO/IEC 23008-12</p>
                <ol>
                  <li><span>ftyp</span><span>heix · mif1 · miaf</span></li>
                  <li><span>meta</span><span>hvcC · colr(nclx) · ispe · pixi</span></li>
                  <li class="is-kept"><span>mdat</span><span>同一批分片，逐字节相同</span></li>
                  <li><span>Exif</span><span>重建后经 cdsc 关联主图</span></li>
                </ol>
              </div>
            </div>

            <p style="margin-top:clamp(20px,3vw,32px);max-width:70ch;color:var(--muted)">
              色彩写入 <span class="mono" style="letter-spacing:.04em">nclx = 9 / 18 / 9 / 0</span>：
              BT.2020 原色、HLG 传输、BT.2020 非恒定亮度矩阵、limited range。少了这几个数字，
              iPhone 只会把 HDR 当 SDR 显示。
            </p>
          </div>
        </div>
      </section>

      <!-- -------------------------------------------------------- privacy -->
      <section class="wrap section" id="privacy">
        <div class="section-head">
          <span class="idx">03</span>
          <h2>数据安全</h2>
          <span class="en">Privacy</span>
        </div>

        <div class="section-grid">
          <p class="lede mono" style="line-height:1.8;letter-spacing:.02em;text-transform:none">
            没有上传，就没有副本；没有副本，就不存在"什么时候删"。
          </p>

          <div>
            <div class="cards">
              <article class="card">
                <span class="card-idx">01</span>
                <h3>本地计算</h3>
                <p>
                  解析 TIFF、重组 HEVC、生成 HEIC、打包 ZIP，全部由本页的 JavaScript 在你的设备上完成，
                  页面里没有任何上传接口。
                </p>
              </article>
              <article class="card">
                <span class="card-idx">02</span>
                <h3>没有服务器</h3>
                <p>
                  这个站点是纯静态页面。Cloudflare 只负责把 HTML / CSS / JS 送到你的浏览器，
                  从始至终接触不到你的照片。
                </p>
              </article>
              <article class="card">
                <span class="card-idx">03</span>
                <h3>不留痕迹</h3>
                <p>
                  文件只存在于当前标签页的内存中，关闭或刷新即消失。没有 Cookie、没有统计脚本、
                  没有第三方请求。
                </p>
              </article>
            </div>

            <p class="note">
              <span>
                <strong>所以，"下载完成后在云端自动删除"这一步并不需要存在。</strong>
                你可以直接打开浏览器开发者工具的 Network 面板，在整个转换与下载过程中不会看到任何
                携带照片的请求。
              </span>
            </p>
          </div>
        </div>
      </section>

      <!-- ---------------------------------------------------------- specs -->
      <section class="wrap section" id="output">
        <div class="section-head">
          <span class="idx">04</span>
          <h2>输出</h2>
          <span class="en">Output</span>
        </div>

        <div class="section-grid">
          <p class="lede mono" style="line-height:1.8;letter-spacing:.02em;text-transform:none">
            与命令行工具 hsp2heic.py 的输出完全一致，SHA-256 也相同。
          </p>

          <table class="spec">
            <caption class="sr-only">输出文件规格</caption>
            <tbody>
              <tr>
                <th scope="row">容器</th>
                <td>HEIC（heix，兼容 mif1 + miaf）</td>
              </tr>
              <tr>
                <th scope="row">图像</th>
                <td>5984 × 4000 · 10-bit · 4:2:0（与相机码流一致）</td>
              </tr>
              <tr>
                <th scope="row">色彩</th>
                <td>BT.2020 / HLG / BT.2020 NC · limited range（nclx 9/18/9/0）</td>
              </tr>
              <tr>
                <th scope="row">元数据</th>
                <td>标准 EXIF；MakerNote 与 GPS 不保留</td>
              </tr>
              <tr>
                <th scope="row">体积</th>
                <td>约为原 .HSP 减去内嵌 JPEG 预览（24 MP 约 2.6–4.5 MB）</td>
              </tr>
              <tr>
                <th scope="row">兼容</th>
                <td>iPhone / iPad 相册原生打开并显示 HDR；Windows 11 需 HEIF 图像扩展；Android 视设备</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ---------------------------------------------------------- about -->
      <section class="wrap section" id="about">
        <div class="section-head">
          <span class="idx">05</span>
          <h2>关于</h2>
          <span class="en">About</span>
        </div>

        <div class="about">
          <div>
            <p>
              这是一个自用的小工具，顺手放上来给同样被 <strong>.HSP</strong> 困住的人。松下的 HLG Photo
              只有自家的 Windows 查看扩展和 Photoshop 插件能打开，手机和 iPad 都不认；而它里面本来就是
              一段 HEVC 码流，转成 HEIC 其实只需要重新封装，不该付出重新压缩的代价。
            </p>
            <p>
              同名项目还有 Windows 图形界面和便携版，适合一次处理整批照片。网页版更适合在 iPad、Mac
              或别人的电脑上临时转几张——不用装东西，也不用把照片交给谁。
            </p>
            <p class="mono" style="letter-spacing:.06em;color:var(--muted);margin-top:1.4rem">
              代码 MIT · 样片 CC BY-NC-SA 4.0 · © 2026 Baizhi-Angelica
            </p>
          </div>

          <div class="links">
            <a href={repo} target="_blank" rel="noopener noreferrer">
              <span class="k">GitHub</span>
              <span class="v">Baizhi-Angelica / panasonic-hsp-to-heic ↗</span>
            </a>
            <a href={exe}>
              <span class="k">Windows exe</span>
              <span class="v">HSP2HEIC.exe ↗</span>
            </a>
            <a href={portable}>
              <span class="k">便携版</span>
              <span class="v">HSP2HEIC-portable-win64.zip ↗</span>
            </a>
            <a href={`${repo}/blob/main/hsp2heic.py`} target="_blank" rel="noopener noreferrer">
              <span class="k">命令行</span>
              <span class="v">hsp2heic.py ↗</span>
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="row">
          <span>HSP → HEIC · 无损重封装</span>
          <span>零上传 · 零存储</span>
        </div>
        <div class="row">
          <span>Panasonic HLG Photo → HEIC in the browser</span>
          <span>
            <a href={repo} target="_blank" rel="noopener noreferrer">GitHub</a>
            <span aria-hidden="true"> · </span>
            <a href="#top">回到顶部 ↑</a>
          </span>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
